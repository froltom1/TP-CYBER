apt-get update -qq >> "$LOG" 2>&1

# Paquets communs aux deux versions
PKGS="apache2 php php-cli libapache2-mod-php openssh-server curl wget python3 perl iproute2 passwd"

# net-tools : disponible sur les deux mais inutile — on ne l'installe pas
# iptables : sur Debian 12, c'est iptables-nft ; sur Debian 13, on préfère nftables natif
# On installe iptables sur les deux (compatibilité iptables-nft assurée)
PKGS="$PKGS iptables"

apt-get install -y -qq $PKGS >> "$LOG" 2>&1
ok "Paquets installés"

# Déterminer le backend firewall disponible
if command -v nft &>/dev/null; then
    FW_BACKEND="nftables"
    ok "Backend firewall détecté : nftables (natif Debian ${DEBIAN_VERSION})"
else
    FW_BACKEND="iptables"
