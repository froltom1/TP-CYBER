#!/usr/bin/env bash
# =============================================================================
# prepare-victim-s5.sh
# Primaris Conseil — Tom Duba — U7 Cybersécurité BTS SIO
#
# Compatible Debian 12 (Bookworm) ET Debian 13 (Trixie)
#
# USAGE (en root sur la VM fraîche) :
#   chmod +x prepare-victim-s5.sh && ./prepare-victim-s5.sh
#
# TEMPS D'EXÉCUTION : ~4-6 min selon la connexion internet
# =============================================================================

set -euo pipefail
LOG="/var/log/prepare-victim-s5.log"
export PATH="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"

# ─── Couleurs ────────────────────────────────────────────────────────────────
RED='\033[0;31m'; GREEN='\033[0;32m'; YELLOW='\033[1;33m'
CYAN='\033[0;36m'; NC='\033[0m'; BOLD='\033[1m'

step() { echo -e "\n${CYAN}${BOLD}[*] $1${NC}" | tee -a "$LOG"; }
ok()   { echo -e "${GREEN}[+] $1${NC}"          | tee -a "$LOG"; }
warn() { echo -e "${YELLOW}[!] $1${NC}"         | tee -a "$LOG"; }
err()  { echo -e "${RED}[-] $1${NC}"            | tee -a "$LOG"; }

# ─── Vérification root ───────────────────────────────────────────────────────
[[ $EUID -ne 0 ]] && err "Ce script doit être lancé en tant que root." && exit 1

# ─── Détection version Debian ────────────────────────────────────────────────
DEBIAN_VERSION=$(grep -oP '(?<=VERSION_ID=")[0-9]+' /etc/os-release 2>/dev/null || echo "12")
echo -e "\n${BOLD}================================================"
echo -e " Préparation VM victim-s5 — TP S5 Cybersécurité"
echo -e " Primaris Conseil | Tom Duba"
echo -e " Debian détecté : version ${DEBIAN_VERSION}"
echo -e "================================================${NC}\n"

